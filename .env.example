# Vidimus local configuration template
# Copy to .env and adjust values as needed. Never commit .env with real secrets.

# Server
PORT=8777
HOST=127.0.0.1
NODE_ENV=development

# Persistent local storage (relative to project root or absolute path)
VIDIMUS_DATA_DIR=./data
VIDIMUS_DB_PATH=./data/vidimus.sqlite
VIDIMUS_UPLOADS_DIR=./data/uploads

# Session & security (generate a 32+ char random string in production)
SESSION_SECRET=vidimus-dev-session-secret-change-in-production
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173

# Upload & job limits
MAX_UPLOAD_MB=25
MAX_CONCURRENT_REVIEWS=2

# Development seed accounts (set to false in production)
VIDIMUS_SEED_DEMO=true

# Optional live review providers (leave empty to use deterministic test adapter)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# LANGUAGETOOL_URL=http://127.0.0.1:8081/v2/check
