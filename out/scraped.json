     },
     {
      "tag": "h1",
      "sig": "body[0]/main[0]/h1[0]",
      "text": "Privacybeleid"
     },
     {
      "tag": "p",
      "sig": "body[0]/main[0]/p[0]",
      "text": "De bibliotheek verwerkt uw persoonsgegevens enkel om uw inschrijving en uw uitleningen te beheren."
     },
     {
      "tag": "h2",
      "sig": "body[0]/main[0]/h2[0]",
      "text": "Welke gegevens?"
     },
     {
      "tag": "li",
      "sig": "body[0]/main[0]/ul[0]/li[0]",
      "text": "Naam, voornaam en geboortedatum"
     },
     {
      "tag": "li",
      "sig": "body[0]/main[0]/ul[0]/li[1]",
      "text": "E-mailadres, voor de herinneringen"
     },
     {
      "tag": "li",
      "sig": "body[0]/main[0]/ul[0]/li[2]",
      "text": "Ontleengeschiedenis van de laatste 12 maanden"
     },
     {
      "tag": "h2",
      "sig": "body[0]/main[0]/h2[1]",
      "text": "Bewaartermijn"
     },
     {
      "tag": "p",
      "sig": "body[0]/main[0]/p[1]",
      "text": "Uw gegevens worden verwijderd twee jaar na het einde van uw inschrijving."
     },
     {
      "tag": "h2",
      "sig": "body[0]/main[0]/h2[2]",
      "text": "Uw rechten"
     },
     {
      "tag": "p",
      "sig": "body[0]/main[0]/p[2]",
      "text": "U kunt op elk moment inzage, verbetering of wissing van uw gegevens vragen."
     },
     {
      "tag": "p",
      "sig": "body[0]/main[0]/p[3]",
      "text": "Voor alle vragen, schrijf naar het adres dat aan het onthaal vermeld staat."
     },
     {
      "tag": "p",
      "sig": "body[0]/footer[0]/p[0]",
      "text": "Fictief document, gemaakt voor een demonstratie."
     }
