      "tag": "a",
      "sig": "body[0]/header[0]/a[2]",
      "text": "Privacy"
     },
     {
      "tag": "h1",
      "sig": "body[0]/main[0]/h1[0]",
      "text": "Rules of use"
     },
     {
      "tag": "h2",
      "sig": "body[0]/main[0]/h2[0]",
      "text": "Article 1 — Registration"
     },
     {
      "tag": "p",
      "sig": "body[0]/main[0]/p[0]",
      "text": "Anyone can register by showing an identity document."
     },
     {
      "tag": "p",
      "sig": "body[0]/main[0]/p[1]",
      "text": "The membership card is personal and may not be lend."
     },
     {
      "tag": "h2",
      "sig": "body[0]/main[0]/h2[1]",
      "text": "Article 2 — Loans and returns"
     },
     {
      "tag": "p",
      "sig": "body[0]/main[0]/p[2]",
      "text": "Items must be returned by the date shown on the loan receipt."
     },
     {
      "tag": "p",
      "sig": "body[0]/main[0]/p[3]",
      "text": "A loan can be renewed once, unless the item is reserved."
     },
     {
      "tag": "h2",
      "sig": "body[0]/main[0]/h2[2]",
      "text": "Article 3 — Late returns"
     },
     {
      "tag": "p",
      "sig": "body[0]/main[0]/p[4]",
      "text": "If an item is late, a reminder is sent by email. No fine is charged."
     },
     {
      "tag": "p",
      "sig": "body[0]/main[0]/p[5]",
      "text": "Lost or damaged items are replaced at the member's expense."
     },
     {
      "tag": "h2",
      "sig": "body[0]/main[0]/h2[3]",
      "text": "Article 4 — Conduct"
     },
     {
      "tag": "p",
      "sig": "body[0]/main[0]/p[6]",
      "text": "Please respect the quiet of the reading rooms."
     },
     {
      "tag": "p",
      "sig": "body[0]/main[0]/p[7]",
      "text": "Drinks are only allowed in the café area."
     },
     {
      "tag": "p",
      "sig": "body[0]/main[0]/p[8]",
      "text": "You can ask your questions at the front desk."
     },
     {
      "tag": "p",
      "sig": "body[0]/footer[0]/p[0]",
      "text": "Fictitious document, made for a demonstration."
     }
    ]
   }
