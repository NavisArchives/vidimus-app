   "en": {
    "url": "http://127.0.0.1:8899/en/confidentialite/",
    "blocks": [
     {
      "tag": "a",
      "sig": "body[0]/header[0]/a[0]",
      "text": "Home"
     },
     {
      "tag": "a",
      "sig": "body[0]/header[0]/a[1]",
      "text": "Rules of use"
     },
     {
      "tag": "a",
      "sig": "body[0]/header[0]/a[2]",
      "text": "Privacy"
     },
     {
      "tag": "h1",
      "sig": "body[0]/main[0]/h1[0]",
      "text": "Privacy policy"
     },
     {
      "tag": "p",
      "sig": "body[0]/main[0]/p[0]",
      "text": "The library processes your personal data only to manage your membership and your loans."
     },
     {
      "tag": "h2",
      "sig": "body[0]/main[0]/h2[0]",
      "text": "What data?"
     },
     {
      "tag": "li",
      "sig": "body[0]/main[0]/ul[0]/li[0]",
      "text": "Surname, first name and date of birth"
     },
     {
      "tag": "li",
      "sig": "body[0]/main[0]/ul[0]/li[1]",
      "text": "Email address, for reminders"
     },
     {
      "tag": "li",
      "sig": "body[0]/main[0]/ul[0]/li[2]",
      "text": "Loan history for the last 12 month"
     },
     {
      "tag": "h2",
      "sig": "body[0]/main[0]/h2[1]",
      "text": "How long we keep it"
     },
     {
      "tag": "p",
      "sig": "body[0]/main[0]/p[1]",
      "text": "Your data is deleted two years after your membership ends."
     },
     {
      "tag": "h2",
      "sig": "body[0]/main[0]/h2[2]",
      "text": "Your rights"
     },
     {
      "tag": "p",
      "sig": "body[0]/main[0]/p[2]",
      "text": "You can ask to access, correct or erase your data at any time."
     },
