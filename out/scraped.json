 "privacy": {
  "label": "Confidentialité / Privacy",
  "slug": "confidentialite",
  "langs": {
   "fr": {
    "url": "http://127.0.0.1:8899/confidentialite/",
    "blocks": [
     {
      "tag": "a",
      "sig": "body[0]/header[0]/a[0]",
      "text": "Accueil"
     },
     {
      "tag": "a",
      "sig": "body[0]/header[0]/a[1]",
      "text": "Règlement"
     },
     {
      "tag": "a",
      "sig": "body[0]/header[0]/a[2]",
      "text": "Confidentialité"
     },
     {
      "tag": "h1",
      "sig": "body[0]/main[0]/h1[0]",
      "text": "Politique de confidentialité"
     },
     {
      "tag": "p",
      "sig": "body[0]/main[0]/p[0]",
      "text": "La bibliothèque traite vos données personnelles uniquement pour gérer votre inscription et vos prêts."
     },
     {
      "tag": "h2",
      "sig": "body[0]/main[0]/h2[0]",
      "text": "Quelles données ?"
     },
     {
      "tag": "li",
      "sig": "body[0]/main[0]/ul[0]/li[0]",
      "text": "Nom, prénom et date de naissance"
     },
     {
      "tag": "li",
      "sig": "body[0]/main[0]/ul[0]/li[1]",
      "text": "Adresse e-mail, pour les rappels"
     },
     {
      "tag": "li",
      "sig": "body[0]/main[0]/ul[0]/li[2]",
      "text": "Historique des prêts des 12 derniers mois"
     },
     {
      "tag": "h2",
      "sig": "body[0]/main[0]/h2[1]",
      "text": "Durée de conservation"
     },
     {
      "tag": "p",
      "sig": "body[0]/main[0]/p[1]",
      "text": "Vos données sont supprimées deux ans après la fin de votre inscription."
     },
     {
      "tag": "h2",
      "sig": "body[0]/main[0]/h2[2]",
      "text": "Vos droits"
     },
     {
      "tag": "p",
      "sig": "body[0]/main[0]/p[2]",
      "text": "Vous pouvez demander l'accès, la rectification ou l'effacement de vos données à tout moment."
     },
     {
      "tag": "p",
      "sig": "body[0]/main[0]/p[3]",
      "text": "Pour toute question, écrivez à l'adresse indiquée à l'accueil."
     },
     {
      "tag": "p",
      "sig": "body[0]/footer[0]/p[0]",
      "text": "Document fictif, créé pour une démonstration."
     }
    ]
   },
   "nl": {
    "url": "http://127.0.0.1:8899/nl/confidentialite/",
    "blocks": [
     {
      "tag": "a",
      "sig": "body[0]/header[0]/a[0]",
      "text": "Home"
     },
     {
      "tag": "a",
