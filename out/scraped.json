 "rules": {
  "label": "Règlement / Reglement",
  "slug": "reglement",
  "langs": {
   "fr": {
    "url": "http://127.0.0.1:8899/reglement/",
    "blocks": [
     {
      "tag": "a",
      "sig": "body[0]/header[0]/a[0]",
      "text": "Accueil"
     },
     {
      "tag": "a",
      "sig": "body[0]/header[0]/a[1]",
      "text": "Règlement"
     },
     {
      "tag": "a",
      "sig": "body[0]/header[0]/a[2]",
      "text": "Confidentialité"
     },
     {
      "tag": "h1",
      "sig": "body[0]/main[0]/h1[0]",
      "text": "Règlement d'utilisation"
     },
     {
      "tag": "h2",
      "sig": "body[0]/main[0]/h2[0]",
      "text": "Article 1 — Inscription"
     },
     {
      "tag": "p",
      "sig": "body[0]/main[0]/p[0]",
      "text": "Toute personne peut s'inscrire sur présentation d'une pièce d'identité."
     },
     {
      "tag": "p",
      "sig": "body[0]/main[0]/p[1]",
      "text": "La carte de membre est personnelle et ne peut être prêtée."
     },
     {
      "tag": "h2",
      "sig": "body[0]/main[0]/h2[1]",
      "text": "Article 2 — Prêt et retour"
     },
     {
      "tag": "p",
      "sig": "body[0]/main[0]/p[2]",
      "text": "Les documents doivent être rendus à la date indiquée sur le ticket de prêt."
     },
     {
      "tag": "p",
      "sig": "body[0]/main[0]/p[3]",
      "text": "Un prêt peut être prolongé une fois, sauf si le document est réservé."
     },
     {
      "tag": "h2",
      "sig": "body[0]/main[0]/h2[2]",
      "text": "Article 3 — Retards"
     },
     {
      "tag": "p",
      "sig": "body[0]/main[0]/p[4]",
      "text": "En cas de retard, un rappel est envoyé par courriel. Aucune amende n'est appliquée."
     },
     {
      "tag": "p",
      "sig": "body[0]/main[0]/p[5]",
      "text": "Les documents perdus ou abîmés sont remplacés aux frais du membre."
     },
     {
      "tag": "h2",
      "sig": "body[0]/main[0]/h2[3]",
      "text": "Article 4 — Comportement"
     },
     {
      "tag": "p",
      "sig": "body[0]/main[0]/p[6]",
      "text": "Merci de respecter le calme des salles de lecture."
     },
     {
      "tag": "p",
      "sig": "body[0]/main[0]/p[7]",
      "text": "Les boissons sont autorisées uniquement dans l'espace café."
     },
     {
      "tag": "p",
      "sig": "body[0]/main[0]/p[8]",
      "text": "Vous pouvez poser vos questions à l'accueil."
     },
     {
      "tag": "p",
      "sig": "body[0]/footer[0]/p[0]",
      "text": "Document fictif, créé pour une démonstration."
     }
    ]
   },
   "nl": {
    "url": "http://127.0.0.1:8899/nl/reglement/",
    "blocks": [
     {
      "tag": "a",
      "sig": "body[0]/header[0]/a[0]",
      "text": "Home"
     },
     {
      "tag": "a",
      "sig": "body[0]/header[0]/a[1]",
      "text": "Reglement"
     },
     {
      "tag": "a",
      "sig": "body[0]/header[0]/a[2]",
      "text": "Privacy"
     },
     {
      "tag": "h1",
      "sig": "body[0]/main[0]/h1[0]",
      "text": "Gebruiksreglement"
     },
     {
      "tag": "h2",
      "sig": "body[0]/main[0]/h2[0]",
      "text": "Artikel 1 — Inschrijving"
     },
     {
      "tag": "p",
      "sig": "body[0]/main[0]/p[0]",
      "text": "Iedereen kan zich inschrijven op vertoon van een identiteitsbewijs."
     },
     {
      "tag": "p",
      "sig": "body[0]/main[0]/p[1]",
      "text": "De lidkaart is persoonlijk en mag niet worden uitgeleend."
     },
     {
      "tag": "h2",
      "sig": "body[0]/main[0]/h2[1]",
      "text": "Artikel 2 — Ontlening en terugbrenging"
     },
     {
      "tag": "p",
      "sig": "body[0]/main[0]/p[2]",
      "text": "De documenten moeten worden teruggebracht op de datum vermeld op het ticket de prêt."
     },
     {
      "tag": "p",
      "sig": "body[0]/main[0]/p[3]",
      "text": "Een uitlening kan eenmaal worden verlengd, tenzij het document gereserveerd is."
     },
     {
      "tag": "h2",
      "sig": "body[0]/main[0]/h2[2]",
      "text": "Artikel 3 — Vertragingen"
     },
     {
      "tag": "p",
      "sig": "body[0]/main[0]/p[4]",
      "text": "Bij vertraging wordt een herinnering per e-mail gestuurd. Er wordt geen boete aangerekend."
     },
     {
      "tag": "p",
      "sig": "body[0]/main[0]/p[5]",
      "text": "Verloren of beschadigde documenten worden vervangen op kosten van het lid."
     },
     {
      "tag": "h2",
      "sig": "body[0]/main[0]/h2[3]",
      "text": "Artikel 4 — Gedrag"
     },
     {
      "tag": "p",
      "sig": "body[0]/main[0]/p[6]",
      "text": "Gelieve de rust in de leeszalen te respecteren."
     },
     {
      "tag": "p",
      "sig": "body[0]/main[0]/p[7]",
      "text": "Dranken zijn enkel toegelaten in de cafetaria."
     },
     {
      "tag": "p",
      "sig": "body[0]/main[0]/p[8]",
      "text": "Je kan je vragen stellen aan het onthaal."
     },
     {
      "tag": "p",
      "sig": "body[0]/footer[0]/p[0]",
      "text": "Fictief document, gemaakt voor een demonstratie."
     }
    ]
   },
   "en": {
